# Run scripts/setup_env.py for local use; never commit actual credentials.
ENVIRONMENT=local
PUBLIC_URL=http://127.0.0.1:8000
DOVE_PORT=8000
# Optional host-side PostgreSQL port. Container-to-container access stays on db:5432.
DOVE_DB_PORT=54329
MODEL_ADAPTER=fixture
EMAIL_ADAPTER=local
OPENAI_MODEL=gpt-4.1-mini
# Generated by scripts/setup_env.py for local use. Provide a separate strong value in production.
POSTGRES_PASSWORD=
# Configure secrets through secure setup or the deployment secret store:
# SECRET_KEY, OPENAI_API_KEY, RESEND_API_KEY,
# RESEND_WEBHOOK_SECRET. See docs/DEPLOYMENT.md.
# Live email additionally requires EMAIL_FROM and REPLY_DOMAIN.
